APP_ENV=development
ALLOW_LOCAL_AUTH=true
LOCAL_AUTH_TOKEN=replace-with-a-random-local-only-token
LOCAL_AUTH_SCOPES=races:read,forecasts:read,selections:read,selections:write
AUTH_MODE=local
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALLOWED_SUBJECTS=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
API_HOST=127.0.0.1
API_PORT=8000
WEB_HOST=127.0.0.1
WEB_PORT=5173
DATABASE_URL=postgresql+psycopg://racing_dev:change-me@127.0.0.1:5432/racing_intelligence_dev
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_AUTH_REQUIRED=false
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
VITE_AUTH0_ALLOWED_SUBJECT=

# Nexus provider controls. Keep all providers disabled until their separate
# approval record, entitlement and quota checks are complete.
NEXUS_DIAGNOSTICS_ENABLED=false
NEXUS_PROVIDER_PUNTERS_EDGE_ENABLED=false
NEXUS_PROVIDER_PUNTERS_EDGE_API_KEY=
NEXUS_PROVIDER_FORMFAV_ENABLED=false
NEXUS_PROVIDER_FORMFAV_API_KEY=
NEXUS_PROVIDER_KROK_ODDS_ENABLED=false
NEXUS_PROVIDER_KROK_ODDS_API_KEY=
NEXUS_PROVIDER_BETFAIR_ENABLED=false
NEXUS_PROVIDER_BETFAIR_APP_KEY=
NEXUS_PROVIDER_BETFAIR_SESSION_TOKEN=
